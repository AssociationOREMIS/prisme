{
  "name": "@oremis/prisme",
  "version": "0.11.0",
  "description": "Design system Vue 3 officiel des applications web OREMIS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AssociationOREMIS/prisme"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/prisme.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*.js"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.js"
    },
    "./tiptap/*": {
      "types": "./dist/tiptap/*.d.ts",
      "import": "./dist/tiptap/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/editor-content.css": "./dist/styles/editor-content.css"
  },
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "predev": "npm run generate:paths",
    "dev": "vite",
    "generate:paths": "node scripts/generate-component-paths.mjs",
    "pretype-check": "npm run generate:paths",
    "type-check": "vue-tsc -p tsconfig.build.json --noEmit",
    "prebuild": "npm run generate:paths",
    "build": "node scripts/build.mjs && vue-tsc -p tsconfig.build.json",
    "pretest": "npm run generate:paths",
    "test": "vitest run",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
